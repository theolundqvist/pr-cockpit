#!/usr/bin/env bash
if [[ "$(/usr/bin/id -u)" == "0" ]]; then echo "pr-cockpit: must not run as root" >&2; exit 1; fi
set -euo pipefail
umask 077

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

if [[ "$(/usr/bin/uname -s)" != "Linux" ]]; then
  echo "pr-cockpit: scripts/install-linux only supports Linux" >&2
  exit 1
fi
linux_packages="sudo apt-get install -y curl git tar unzip coreutils systemd xdg-utils libnss3 libgtk-3-0 libgbm1 libasound2 libxss1 libx11-xcb1 libdrm2 libxkbcommon0 libatspi2.0-0"
for prerequisite in git curl tar unzip sha256sum realpath systemctl xdg-mime stat sed wc tr sort od mktemp chmod ln mv rm rmdir cat sleep cut dirname readlink; do
  command -v "$prerequisite" >/dev/null 2>&1 || {
    echo "pr-cockpit: missing Linux system prerequisites — on Debian/Ubuntu run: $linux_packages" >&2
    exit 1
  }
done
if [[ "${1:-}" == "--dry-run" && "$#" -eq 1 ]]; then
  "$root/scripts/install-linux-tools" --dry-run
  echo "pr-cockpit: would stage, validate, and activate an immutable Linux release from $root"
  exit 0
fi
if [[ "$#" -gt 1 || ( "$#" -eq 1 && "${1:-}" != "--gui" ) ]]; then
  echo "usage: scripts/install-linux [--dry-run|--gui]" >&2
  exit 2
fi

"$root/scripts/install-linux-tools"
export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/pr-cockpit-tools/bin:$PATH"


exec bun "$root/scripts/linux-lifecycle.ts" install "$root" "$@"
