#!/usr/bin/env bash
# One-command installer, safe to rerun as the upgrade path:
#   curl -fsSL https://raw.githubusercontent.com/theolundqvist/pr-cockpit/main/scripts/bootstrap | bash
set -euo pipefail

repo_slug="theolundqvist/pr-cockpit"
repo_url="https://github.com/$repo_slug.git"
target="${COCKPIT_HOME:-$HOME/.pr-cockpit}"
dry_run="${COCKPIT_BOOTSTRAP_DRY_RUN:-0}"
legacy_backup=""
legacy_migration=0

if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
  bold=$'\033[1m'
  accent=$'\033[36m'
  green=$'\033[32m'
  reset=$'\033[0m'
else
  bold=""
  accent=""
  green=""
  reset=""
fi

say() { echo "pr-cockpit: $*"; }
die() { echo "pr-cockpit: $*" >&2; exit 1; }
stage() { printf '\n%b[%s]%b %b%s%b\n' "$accent" "$1" "$reset" "$bold" "$2" "$reset"; }
status() { printf '%b  ready%b  %s\n' "$green" "$reset" "$1"; }

run() {
  if [[ "$dry_run" == "1" ]]; then
    say "dry run, skipping: $*"
    return 0
  fi
  "$@"
}

# Piped into bash, stdin is the script body itself, so every prompt and every
# interactive child reads the terminal on fd 3 instead.
have_tty=0
if { exec 3</dev/tty; } 2>/dev/null; then
  have_tty=1
fi

printf '\n%bWelcome to PR Cockpit%b\n' "$accent$bold" "$reset"
printf "Let's get your pull-request cockpit ready.\n"
stage "1/3" "Check prerequisites"

# Answers yes only on an explicit y from the terminal; no terminal means no consent.
confirm() {
  local reply=""
  if [[ "$have_tty" -ne 1 ]]; then
    return 1
  fi
  printf '%bpr-cockpit:%b %b%s%b %b[y/N]%b ' "$accent" "$reset" "$bold" "$1" "$reset" "$accent" "$reset"
  read -r reply <&3 || return 1
  [[ "$reply" == [yY]* ]]
}
agent_instruction_marker="<!-- pr-cockpit-agent-instructions -->"
agent_instruction_block='<!-- pr-cockpit-agent-instructions -->
## PR Cockpit
For pull-request reads, use `pr-cockpit owner/repo#N` instead of `gh pr view`, `gh api`, or direct GitHub API reads. Use `--json` only for automation, `--diff` for the cached diff, and `--file PATH` for a file at the PR head. When waiting on a pull request, use `pr-cockpit listen owner/repo#N` instead of polling. Resolve settled review threads with `pr-cockpit resolve owner/repo#N HANDLE`.
<!-- /pr-cockpit-agent-instructions -->'
agent_instruction_targets=()
install_agent_instructions=0

prepare_agent_instructions() {
  [[ "$have_tty" -eq 1 ]] || return 0
  local common="$HOME/.config/AGENTS.md"
  local candidate
  if [[ -e "$common" || -L "$common" ]]; then
    agent_instruction_targets=("$common")
  else
    for candidate in \
      "$HOME/.config/omp/agent/AGENTS.md:omp" \
      "${CODEX_HOME:-$HOME/.codex}/AGENTS.md:codex" \
      "$HOME/.claude/CLAUDE.md:claude"; do
      local path="${candidate%:*}"
      local command="${candidate##*:}"
      if [[ -e "$path" || -L "$path" ]] || command -v "$command" >/dev/null 2>&1; then
        agent_instruction_targets+=("$path")
      fi
    done
  fi
  ((${#agent_instruction_targets[@]})) || return 0


  local pending=()
  for candidate in "${agent_instruction_targets[@]}"; do
    if [[ ! -f "$candidate" ]] || ! grep -Fq "$agent_instruction_marker" "$candidate"; then
      pending+=("$candidate")
    fi
  done
  if ((${#pending[@]} == 0)); then
    agent_instruction_targets=()
    return 0
  fi
  agent_instruction_targets=("${pending[@]}")

  printf '\n%bOptional follow-up%b\n' "$accent$bold" "$reset"
  printf 'You can teach supported assistants to use the local PR cache for pull-request reads.\n'
  printf '%bAdd these instructions to:%b\n' "$bold" "$reset"
  for candidate in "${agent_instruction_targets[@]}"; do
    printf '  %b%s%b\n' "$green" "$candidate" "$reset"
  done
  printf '\n%s\n\n' "$agent_instruction_block"
  if confirm "Teach assistants to use pr-cockpit instead of gh for pull-request reads?"; then
    install_agent_instructions=1
  else
    agent_instruction_targets=()
  fi
}

write_agent_instructions() {
  [[ "$install_agent_instructions" -eq 1 ]] || return 0
  if [[ "$dry_run" == "1" ]]; then
    say "would add assistant instructions to ${agent_instruction_targets[*]}"
    return 0
  fi
  local path
  for path in "${agent_instruction_targets[@]}"; do
    if {
      mkdir -p "$(dirname "$path")"
      [[ ! -s "$path" ]] || printf '\n'
      printf '%s\n' "$agent_instruction_block"
    } >> "$path"; then
      say "added assistant instructions to $path"
    else
      say "couldn't add assistant instructions to $path"
    fi
  done
}


need() {
  local what="$1" fix="$2"
  if [[ "$have_tty" -ne 1 ]]; then
    die "$what is missing and there is no terminal to ask on — run: $fix"
  fi
  die "$what is missing — run: $fix"
}

if [[ "$(uname -s)" != "Darwin" ]]; then
  die "macOS only — the app is an Electron bundle driven by LaunchAgents, launchctl, plutil and ditto"
fi

brew_bin="$(command -v brew || true)"

if ! command -v git >/dev/null 2>&1; then
  if confirm "git not found, install the Xcode command line tools now?"; then
    run xcode-select --install || true
    say "finish the Xcode command line tools install, then rerun this command"
    exit 0
  fi
  need "git" "xcode-select --install"
fi

if ! command -v bun >/dev/null 2>&1; then
  if [[ -n "$brew_bin" ]]; then
    if ! confirm "bun not found, install it with Homebrew now?"; then
      need "bun" "brew install oven-sh/bun/bun"
    fi
    run "$brew_bin" install oven-sh/bun/bun
    PATH="$("$brew_bin" --prefix)/bin:$PATH"
  else
    if ! confirm "bun not found, install it from https://bun.sh now?"; then
      need "bun" "curl -fsSL https://bun.sh/install | bash"
    fi
    run bash -c 'curl -fsSL https://bun.sh/install | bash'
    PATH="$HOME/.bun/bin:$PATH"
  fi
  export PATH
  if [[ "$dry_run" != "1" ]] && ! command -v bun >/dev/null 2>&1; then
    die "bun still not on PATH after install — open a new shell and rerun this command"
  fi
fi

if ! command -v gh >/dev/null 2>&1; then
  if [[ -z "$brew_bin" ]]; then
    need "the GitHub CLI (gh)" "install Homebrew from https://brew.sh, then 'brew install gh' (or download gh from https://cli.github.com)"
  fi
  if ! confirm "the GitHub CLI (gh) is not found, install it with Homebrew now?"; then
    need "the GitHub CLI (gh)" "brew install gh"
  fi
  run "$brew_bin" install gh
  PATH="$("$brew_bin" --prefix)/bin:$PATH"
  export PATH
  if [[ "$dry_run" != "1" ]] && ! command -v gh >/dev/null 2>&1; then
    die "gh still not on PATH after install — open a new shell and rerun this command"
  fi
fi

if command -v gh >/dev/null 2>&1 && ! gh auth status >/dev/null 2>&1; then
  if [[ "$have_tty" -ne 1 ]]; then
    die "gh is not authenticated and there is no terminal to log in on — run 'gh auth login', then rerun this command"
  fi
  if ! confirm "gh is not authenticated, run 'gh auth login' now?"; then
    die "gh needs access to read your pull requests — run 'gh auth login', then rerun this command"
  fi
  # Cockpit reads PRs and posts reviews through gh, so the token needs repo scope.
  run gh auth login --hostname github.com --git-protocol https --scopes repo <&3
  if [[ "$dry_run" != "1" ]] && ! gh auth status >/dev/null 2>&1; then
    die "gh is still not authenticated — run 'gh auth login', then rerun this command"
  fi
fi


status "Prerequisites available"
stage "2/3" "Prepare checkout"

if [[ -n "${COCKPIT_HOME:-}" ]]; then
  say "installing to $target — this path is baked into the LaunchAgents, so don't move it afterwards (rerun this command if you do)"
fi

remote_slug() {
  local url="$1"
  url="${url%.git}"
  url="${url#git@github.com:}"
  url="${url#ssh://git@github.com/}"
  url="${url#https://github.com/}"
  url="${url#http://github.com/}"
  printf '%s' "$url"
}

replace_legacy_checkout() {
  local replacement="${target}.new.$$"
  local previous="${target}.old.$$"

  say "replacing the legacy private checkout at $target"
  if [[ "$dry_run" == "1" ]]; then
    say "would clone $repo_slug, replace $target, and remove the legacy checkout"
    return
  fi

  rm -rf "$replacement" "$previous"
  if ! git clone --quiet "$repo_url" "$replacement"; then
    rm -rf "$replacement"
    die "couldn't clone $repo_slug — the legacy checkout is unchanged"
  fi
  mv "$target" "$previous"
  if ! mv "$replacement" "$target"; then
    mv "$previous" "$target"
    rm -rf "$replacement"
    die "couldn't replace $target — the legacy checkout was restored"
  fi
  legacy_backup="$previous"
}
uninstall_legacy_app() {
  [[ "$legacy_migration" -eq 1 ]] || return 0
  say "uninstalling the legacy PR Cockpit app"
  if [[ "$dry_run" == "1" ]]; then
    say "would stop its background services and remove its app bundle"
    return
  fi
  local domain="gui/$(id -u)"
  launchctl bootout "$domain/app.pr-cockpit.server" >/dev/null 2>&1 || true
  launchctl bootout "$domain/app.pr-cockpit" >/dev/null 2>&1 || true
  rm -f \
    "$HOME/Library/LaunchAgents/app.pr-cockpit.server.plist" \
    "$HOME/Library/LaunchAgents/app.pr-cockpit.plist"
  rm -rf "$HOME/Applications/PR Cockpit.app"
}


if [[ -e "$target" ]]; then
  [[ "$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)" == "$(cd "$target" && pwd -P)" ]] || die "$target already exists and is not a git checkout — move it aside or set COCKPIT_HOME to another path"
  origin="$(git -C "$target" remote get-url origin 2>/dev/null || true)"
  origin_slug="$(remote_slug "$origin")"
  if [[ "$origin_slug" == "theolundqvist/pr-cockpit-private" ]]; then
    legacy_migration=1
    replace_legacy_checkout
  elif [[ "$origin_slug" == "$repo_slug" ]]; then
    say "updating existing checkout at $target"
    if ! pull_reason="$("$target/scripts/update-pull" 2>&1 >/dev/null)"; then
      if [[ -z "${COCKPIT_HOME:-}" && ( "$pull_reason" == local\ history\ diverged* || "$pull_reason" == branch\ *\ only\ exists\ locally* ) ]]; then
        replace_legacy_checkout
      else
        die "couldn't fast-forward $target (${pull_reason:-reason above}) — resolve it there, then rerun this command"
      fi
    fi
  else
    die "$target is a checkout of ${origin:-an unknown remote}, not $repo_slug — move it aside or set COCKPIT_HOME to another path"
  fi
else
  say "cloning $repo_slug into $target"
  run git clone --quiet "$repo_url" "$target"
fi
uninstall_legacy_app
status "Checkout prepared"


stage "3/3" "Install PR Cockpit"
if ! run "$target/scripts/install"; then
  if [[ -n "$legacy_backup" ]]; then
    rm -rf "$target"
    mv "$legacy_backup" "$target"
    if "$target/scripts/install"; then
      die "installer failed — the legacy checkout and its services were restored"
    fi
    die "installer failed — the legacy checkout was restored, but its services could not be recovered"
  fi
  die "installer failed"
fi
status "Installation complete"
if [[ -n "$legacy_backup" ]]; then
  rm -rf "$legacy_backup"
fi
prepare_agent_instructions
write_agent_instructions
