#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

platform="$(uname -s)"
if [[ "$platform" == "Linux" ]]; then
  exec "$root/scripts/install-linux" "$@"
fi

if [[ -t 1 ]]; then
  bold=$'\033[1m'
  accent=$'\033[36m'
  green=$'\033[32m'
  reset=$'\033[0m'
else
  bold=""
  accent=""
  green=""
  reset=""
fi

stage() { printf '\n%b[%s]%b %s\n' "$accent" "$1" "$reset" "$2"; }

quiet_log=""
cleanup_quiet_log() {
  [[ -z "$quiet_log" ]] || rm -f "$quiet_log"
}
trap cleanup_quiet_log EXIT

quiet_in() {
  local label="$1"
  local directory="$2"
  local status
  shift 2
  quiet_log="$(mktemp "${TMPDIR:-/tmp}/pr-cockpit-install.XXXXXX")"
  if (cd "$directory" && "$@") >"$quiet_log" 2>&1; then
    rm -f "$quiet_log"
    quiet_log=""
    return 0
  else
    status=$?
    printf '%bpr-cockpit: %s failed%b\n' "$bold" "$label" "$reset" >&2
    cat "$quiet_log" >&2
    rm -f "$quiet_log"
    quiet_log=""
    return "$status"
  fi
}

missing=0
if ! command -v bun >/dev/null 2>&1; then
  echo "pr-cockpit: bun not found — install from https://bun.sh"
  missing=1
fi
if ! command -v gh >/dev/null 2>&1; then
  echo "pr-cockpit: gh not found — install from https://cli.github.com"
  missing=1
fi
if [[ "$missing" -eq 1 ]]; then
  exit 1
fi

bun="$(command -v bun)"
gh_bin="$(command -v gh)"
launch_path="$HOME/.local/bin:$(dirname "$bun"):$(dirname "$gh_bin"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if [[ "$platform" != "Darwin" ]]; then
  echo "pr-cockpit: unsupported platform: $platform"
  exit 1
fi
stage_count=6

stage "1/$stage_count" "Install dependencies"
quiet_in "root dependency install" "$root" "$bun" install
quiet_in "UI dependency install" "$root/ui" "$bun" install
if [[ "$platform" == "Darwin" ]]; then
  quiet_in "shell dependency install" "$root/shell" "$bun" install
fi

# Both guards import from node_modules, so they only run once install has populated it.
stage "2/$stage_count" "Verify release"
quiet_in "release check" "$root" "$bun" scripts/check-release.ts
quiet_in "worktree runtime check" "$root" "$bun" scripts/check-worktree-runtime.ts

stage "3/$stage_count" "Build UI"
quiet_in "UI build" "$root/ui" "$bun" run build


stage "4/6" "Install desktop app"
COCKPIT_GH_BIN="$gh_bin" "$root/scripts/make-app.sh"

stage "5/6" "Install CLI and runtime"
cli_dir="$(dirname "$bun")"
if [[ ! -w "$cli_dir" ]]; then
  cli_dir="$HOME/.local/bin"
  mkdir -p "$cli_dir"
fi
if ln -sfn "$root/scripts/pr-cockpit" "$cli_dir/pr-cockpit" 2>/dev/null; then
  if [[ ":$PATH:" != *":$cli_dir:"* ]]; then
    echo "pr-cockpit: CLI linked at $cli_dir/pr-cockpit — add $cli_dir to PATH to call 'pr-cockpit' from a shell; the app itself works without it"
  fi
else
  echo "pr-cockpit: couldn't link the CLI into $cli_dir, skipping it; the app itself works without it"
fi

# macOS blocks LaunchAgents from executing scripts in protected folders such as
# ~/Documents. Keep a tiny launcher outside the checkout; it points back to the
# source root and invokes Bun/Electron directly, both of which launch correctly.
runtime_dir="$HOME/Library/Application Support/PR Cockpit"
runtime_launcher="$runtime_dir/launch"
mkdir -p "$runtime_dir"
cp "$root/scripts/cockpit" "$runtime_launcher"
chmod +x "$runtime_launcher"

echo "pr-cockpit: packaging shell app (so it shows up as \"PR Cockpit\", not \"Electron\", in Activity Monitor)..."
electron_src="$root/shell/node_modules/electron/dist/Electron.app"
bundle="$root/shell/PR Cockpit.app"
if [[ -d "$electron_src" ]]; then
  electron_version="$(grep -m1 '"version"' "$root/shell/node_modules/electron/package.json" | sed -E 's/.*"version": *"([^"]+)".*/\1/')"
  icon_hash="$(shasum -a 256 "$root/assets/icon.icns" | awk '{print substr($1, 1, 12)}')"
  icon_name="pr-cockpit-$icon_hash"
  icon_version="$(printf '%d' "0x${icon_hash:0:7}")"
  rm -rf "$bundle"
  ditto "$electron_src" "$bundle"
  mv "$bundle/Contents/MacOS/Electron" "$bundle/Contents/MacOS/PR Cockpit"
  plutil -replace CFBundleName -string "PR Cockpit" "$bundle/Contents/Info.plist"
  plutil -replace CFBundleDisplayName -string "PR Cockpit" "$bundle/Contents/Info.plist"
  plutil -replace CFBundleExecutable -string "PR Cockpit" "$bundle/Contents/Info.plist"
  plutil -replace CFBundleIdentifier -string "app.pr-cockpit" "$bundle/Contents/Info.plist"
  plutil -replace CFBundleIconFile -string "$icon_name" "$bundle/Contents/Info.plist"
  plutil -replace CFBundleVersion -string "$icon_version" "$bundle/Contents/Info.plist"
  plutil -replace CFBundleURLTypes -json '[{"CFBundleURLName":"app.pr-cockpit","CFBundleURLSchemes":["prcockpit"]}]' "$bundle/Contents/Info.plist"
  cp "$root/assets/icon.icns" "$bundle/Contents/Resources/$icon_name.icns"
  echo "$electron_version" > "$bundle/Contents/Resources/pr-cockpit-electron-version"
  codesign --force --deep -s - "$bundle" >/dev/null 2>&1 || echo "pr-cockpit: ad-hoc codesign failed, continuing (Gatekeeper may complain on first launch)"
  echo "pr-cockpit: packaged $bundle"
else
  echo "pr-cockpit: electron dist not found at $electron_src, skipping shell app packaging (will fall back to the plain electron binary)"
fi

# Register both bundles after replacing their icon resources so Finder and the
# Dock do not retain a stale icon for the unchanged bundle identifiers.
lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if [[ -x "$lsregister" ]]; then
  "$lsregister" -f "$HOME/Applications/PR Cockpit.app" "$bundle" >/dev/null 2>&1 || true
fi

stage "6/6" "Configure and start services"
config_dir="$HOME/.config/pr-cockpit"
config_file="$config_dir/config"
if [[ ! -f "$config_file" ]]; then
  mkdir -p "$config_dir"
  cat > "$config_file" <<EXAMPLE
# pr-cockpit config — plain shell vars, env still wins over these.
# Uncomment and edit to point the cockpit at your own repos.
# COCKPIT_REPOS="owner/repo,owner/other-repo"
# COCKPIT_PORT=4820
# COCKPIT_PROXY="build-server"      # optional Cockpit replica source over SSH
# COCKPIT_PROXY_PORT=4820           # Cockpit port on the SSH host
# COCKPIT_DEFAULT_REPO="owner/repo"
# COCKPIT_TMUX_HOSTS="builder,build-vm"
# COCKPIT_RELAY_URL="https://my-relay.example.workers.dev"
# COCKPIT_REVIEW_BOTS='[{"login":"my-review-bot","patterns":["Confidence Score:\\\\s*(\\\\d)/5"]}]'
EXAMPLE
  echo "pr-cockpit: wrote example config to $config_file"
fi

# Use the same config precedence as scripts/cockpit to restart the existing
# backend on update. Otherwise a healthy but stale server keeps old code and
# its old LaunchAgent environment indefinitely.
install_port_env="${COCKPIT_PORT:-}"
install_tmux_hosts_env="${COCKPIT_TMUX_HOSTS:-}"
install_proxy_env="${COCKPIT_PROXY:-}"
install_proxy_port_env="${COCKPIT_PROXY_PORT:-}"
if [[ -f "$config_file" ]]; then
  # shellcheck disable=SC1090
  source "$config_file"
fi
install_port="${install_port_env:-${COCKPIT_PORT:-4820}}"
install_tmux_hosts="${install_tmux_hosts_env:-${COCKPIT_TMUX_HOSTS:-}}"
install_proxy="${install_proxy_env:-${COCKPIT_PROXY:-}}"
install_proxy_port="${install_proxy_port_env:-${COCKPIT_PROXY_PORT:-4820}}"
install_proxy="${install_proxy#ssh://}"
install_proxy="${install_proxy%/}"

agent_dir="$HOME/Library/LaunchAgents"
agent_label="app.pr-cockpit"
agent_plist="$agent_dir/$agent_label.plist"
server_agent_label="$agent_label.server"
server_agent_plist="$agent_dir/$server_agent_label.plist"
agent_log_dir="$HOME/Library/Logs/PR Cockpit"
server_agent_owns_port() {
  local agent_pid
  local listener_pid
  agent_pid="$(launchctl print "gui/$(id -u)/$server_agent_label" 2>/dev/null | sed -n 's/^[[:space:]]*pid = //p' | head -n 1)" || return 1
  [[ "$agent_pid" =~ ^[0-9]+$ ]] || return 1
  while IFS= read -r listener_pid; do
    [[ "$listener_pid" == "$agent_pid" ]] && return 0
  done < <(lsof -nP -tiTCP:"$install_port" -sTCP:LISTEN 2>/dev/null)
  return 1
}

health_is_ours() {
  local health
  health="$(curl --max-time 2 -fsS "http://127.0.0.1:$install_port/healthz" 2>/dev/null)" || return 1
  [[ "$health" == *"\"root\":\"$root\""* ]] && return 0
  [[ "$health" != *'"root":'* ]] && server_agent_owns_port
}

mkdir -p "$agent_dir"
mkdir -p "$agent_log_dir"
# launchd never sources a shell profile. The coding harness the agents drive resolves its
# auth store under XDG_DATA_HOME and its instructions under XDG_CONFIG_HOME, and silently
# falls back to a stale store when they are missing, so bake them into the agents.
xdg_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
xdg_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"

cat > "$server_agent_plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$server_agent_label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>COCKPIT_ROOT=$root</string>
    <string>COCKPIT_GH_BIN=$gh_bin</string>
    <string>PATH=$launch_path</string>
    <string>COCKPIT_TMUX_HOSTS=$install_tmux_hosts</string>
    <string>COCKPIT_REPLICA_SSH_HOST=$install_proxy</string>
    <string>COCKPIT_PROXY_PORT=$install_proxy_port</string>
    <string>COCKPIT_NO_BUILD=1</string>
    <string>COCKPIT_LAUNCHER=$runtime_launcher</string>
    <string>XDG_DATA_HOME=$xdg_data_home</string>
    <string>XDG_CONFIG_HOME=$xdg_config_home</string>
    <string>$runtime_launcher</string>
    <string>--server-only</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>$agent_log_dir/server.log</string>
  <key>StandardErrorPath</key>
  <string>$agent_log_dir/server.err.log</string>
</dict>
</plist>
PLIST
cat > "$agent_plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$agent_label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>COCKPIT_ROOT=$root</string>
    <string>COCKPIT_LAUNCHER=$runtime_launcher</string>
    <string>COCKPIT_GH_BIN=$gh_bin</string>
    <string>PATH=$launch_path</string>
    <string>COCKPIT_NO_BUILD=1</string>
    <string>XDG_DATA_HOME=$xdg_data_home</string>
    <string>XDG_CONFIG_HOME=$xdg_config_home</string>
    <string>$runtime_launcher</string>
    <string>--cockpit-hidden</string>
    <string>--foreground-shell</string>
    <string>--managed-server</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>$agent_log_dir/launch-agent.log</string>
  <key>StandardErrorPath</key>
  <string>$agent_log_dir/launch-agent.err.log</string>
</dict>
</plist>
PLIST

echo "pr-cockpit: starting background services..."
shell_agent_loaded=0
shell_agent_root=""
if agent_state="$(launchctl print "gui/$(id -u)/$agent_label" 2>/dev/null)"; then
  shell_agent_loaded=1
  # A loaded job keeps the environment it was bootstrapped with, so rewriting the
  # plist cannot move a registration from an older root onto this install. Such a
  # job crash-loops: its launcher sees this install's server on the port, reads a
  # foreign root in /healthz, and exits "serving a different instance".
  shell_agent_root="$(printf '%s\n' "$agent_state" | sed -n 's/^[[:space:]]*COCKPIT_ROOT=\(.*\)$/\1/p' | head -n 1)"
fi
if health_is_ours; then
  curl --max-time 2 -fsS -X POST "http://127.0.0.1:$install_port/api/shutdown" >/dev/null 2>&1 || true
  for _ in {1..20}; do
    health_is_ours || break
    sleep 0.1
  done
elif curl --max-time 2 -fsS -o /dev/null "http://127.0.0.1:$install_port/healthz"; then
  echo "pr-cockpit: port $install_port is already serving another app; pick a free port with COCKPIT_PORT (env, or COCKPIT_PORT=4821 in $config_file) and rerun" >&2
  exit 1
fi
launchctl bootout "gui/$(id -u)/$server_agent_label" >/dev/null 2>&1 || true

# bootout returns before launchd has always released the old service. Retrying
# avoids an intermittent Bootstrap failed: 5 when installing an update while
# Cockpit is still shutting down.
bootstrap_agent() {
  local plist="$1"
  local loaded=0
  for _ in {1..20}; do
    if launchctl bootstrap "gui/$(id -u)" "$plist" >/dev/null 2>&1; then
      loaded=1
      break
    fi
    sleep 0.25
  done
  if [[ "$loaded" -ne 1 ]]; then
    launchctl bootstrap "gui/$(id -u)" "$plist"
  fi
}

# Restart only the server. A loaded renderer stays alive and picks up UI assets
# on its next navigation or refresh.
bootstrap_agent "$server_agent_plist"
if [[ "$shell_agent_loaded" -eq 1 && "$shell_agent_root" == "$root" ]]; then
  echo "pr-cockpit: preserving running app"
else
  if [[ "$shell_agent_loaded" -eq 1 ]]; then
    echo "pr-cockpit: replacing the app registration for ${shell_agent_root:-an unknown root}"
    launchctl bootout "gui/$(id -u)/$agent_label" >/dev/null 2>&1 || true
  fi
  bootstrap_agent "$agent_plist"
fi

server_ready=0
server_deadline=$((SECONDS + 60))
while (( SECONDS < server_deadline )); do
  if server_agent_owns_port && health_is_ours; then
    server_ready=1
    break
  fi
  sleep 0.2
done
if [[ "$server_ready" -ne 1 ]]; then
  echo "pr-cockpit: managed server failed to become ready on port $install_port" >&2
  exit 1
fi
if installed_rev="$(git -C "$root" rev-parse HEAD 2>/dev/null)"; then
  marker_tmp="$runtime_dir/installed-rev.$$"
  if ! { printf '%s\n' "$installed_rev" > "$marker_tmp" && mv "$marker_tmp" "$runtime_dir/installed-rev"; }; then
    rm -f "$marker_tmp" || true
  fi
fi

printf '\n%bPR Cockpit is ready%b\n' "$green$bold" "$reset"
echo "  App      $HOME/Applications/PR Cockpit.app"
echo "  CLI      pr-cockpit owner/repo#123"
echo "  Hotkey   cmd+opt+k"
echo "  Setup    Open the app and follow first-run setup"
echo "  Upgrade  pr-cockpit update"
