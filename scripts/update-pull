#!/usr/bin/env bash
# Fetch + fast-forward, treating up-to-date and local-ahead as a clean no-op.
# Manual updates preserve conflicting tracked edits on a local-edits-<timestamp>
# branch before retrying; automatic updates fail without moving those edits.
# exit 0 = safe to restart ("noop"/"updated"); exit 1 = do not restart.
set -Eeuo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

branch="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$branch" == "HEAD" ]]; then
  echo "detached HEAD — not on a branch" >&2
  exit 1
fi

# A broken installed desktop must not silently pull whichever feature branch
# happens to be checked out. Unattended startup recovery only follows main.
if [[ "${COCKPIT_STARTUP_RECOVERY:-0}" == "1" && "$branch" != "main" ]]; then
  echo "automatic startup recovery requires the main branch (currently '$branch')" >&2
  exit 1
fi

# Automatic recovery must not move aside or discard tracked local work. The
# manual updater retains its existing backup-branch behavior.
if [[ "${COCKPIT_AUTO_UPDATE:-0}" == "1" ]] && ! git diff --quiet HEAD --; then
  echo "tracked local edits prevent automatic update — resolve manually" >&2
  exit 1
fi

if ! fetch_err="$(git fetch --quiet origin "$branch" 2>&1)"; then
  if [[ "$fetch_err" == *"couldn't find remote ref"* ]]; then
    echo "branch '$branch' only exists locally — push it or switch to a tracked branch" >&2
  else
    echo "couldn't reach origin — check your network" >&2
  fi
  exit 1
fi

remote="origin/$branch"

# origin is an ancestor of HEAD: we're up-to-date or ahead — nothing to pull, restart with current code
if git merge-base --is-ancestor "$remote" HEAD; then
  echo "noop"
  exit 0
fi

# HEAD is an ancestor of origin: clean fast-forward
if git merge-base --is-ancestor HEAD "$remote"; then
  if merge_err="$(git merge --ff-only --quiet "$remote" 2>&1)"; then
    echo "updated"
    exit 0
  fi
  # ff refused: uncommitted tracked edits collide with incoming files. Preserve them on a
  # branch (stash create commits index+tree without touching either), clean, retry.
  if [[ "${COCKPIT_AUTO_UPDATE:-0}" == "1" ]]; then
    echo "fast-forward merge failed; automatic update will not move local edits" >&2
    exit 1
  fi
  if snapshot="$(git stash create "local edits before update")" && [[ -n "$snapshot" ]]; then
    backup="local-edits-$(date -u +%Y%m%d-%H%M%S)"
    git branch "$backup" "$snapshot"
    git reset --hard --quiet HEAD
    if git merge --ff-only --quiet "$remote"; then
      echo "updated"
      echo "uncommitted local edits were moved aside to branch $backup" >&2
      exit 0
    fi
  fi
  if [[ -n "$merge_err" ]]; then echo "$merge_err" >&2; fi
  echo "fast-forward merge failed" >&2
  exit 1
fi

echo "local history diverged from $remote — resolve manually" >&2
exit 1
