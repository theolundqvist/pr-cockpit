#!/usr/bin/env bash
set -Eeuo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$root"

data_dir="${COCKPIT_DATA_DIR:-$root/data}"
platform="$(uname -s)"
if [[ "$platform" == "Linux" ]]; then
  exec "$root/scripts/update-linux" "$@"
fi
if [[ "$platform" != "Darwin" ]]; then
  echo "UPDATE_FAILED unsupported platform: $platform" >&2
  exit 1
fi

# An automatic update is never allowed to launch or reveal the desktop app.
# Manual updates keep their historical handoff unless non-GUI was requested.
non_gui=0
if [[ "${COCKPIT_AUTO_UPDATE:-0}" == "1" || "${COCKPIT_UPDATE_GUI:-1}" == "0" ]]; then
  non_gui=1
fi

fail_and_relaunch() {
  local status=$?
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) update failed at: $BASH_COMMAND" >> "$data_dir/update-failures.log" 2>/dev/null || true
  if [[ "$non_gui" -eq 1 ]]; then
    echo "UPDATE_FAILED installation failed; see $data_dir/update-failures.log" >&2
    exit "$status"
  fi
  echo "pr-cockpit: restart step failed after pull, relaunching (last-good build if the rebuild broke)..."
  exec env COCKPIT_SKIP_RECONCILE=1 "$root/scripts/cockpit" --managed-server --show
}

mkdir -p "$data_dir"

old_rev="$(git rev-parse HEAD)"

# Pull gates everything: a failed pull must not restart, so the app stays up and reports it instead of looping.
echo "pr-cockpit: pulling..."
if ! pull_reason="$("$root/scripts/update-pull" 2>&1 >/dev/null)"; then
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) update-pull failed: $pull_reason" >> "$data_dir/update-failures.log" 2>/dev/null || true
  echo "UPDATE_FAILED ${pull_reason:-pull failed}" >&2
  exit 1
fi
if [[ -n "${pull_reason:-}" ]]; then
  echo "pr-cockpit: $pull_reason"
fi

# Manual handoff closes the pipe after PULL_OK; non-GUI callers need the
# installer result and diagnostics on their original stdout/stderr.
echo "PULL_OK"
if [[ "$non_gui" -eq 0 ]]; then
  exec >>"$data_dir/update.log" 2>&1
fi
trap fail_and_relaunch ERR

new_rev="$(git rev-parse HEAD)"

# Reconcile launch agents, wrappers, CLI, dependencies, and the packaged shell on every update.
echo "pr-cockpit: reconciling install..."
"$root/scripts/install"

echo "pr-cockpit: $old_rev -> $new_rev"
if [[ "$non_gui" -eq 0 ]]; then
  echo "pr-cockpit: restarting..."
  exec "$root/scripts/cockpit" --managed-server --show
fi
echo "auto-update: installed $new_rev"
